# topa-LE Unraid Array Serial
# Autorisierte Hardware-IDs fuer physische Datentraeger.
#
# Die regulaeren persistent-storage-Regeln laufen vorher.
# Insbesondere bei USB-SATA-Bridges darf ata_id hier NICHT
# erneut aufgerufen werden: manche Bridges liefern defekte
# ATA-Kennungen trotz korrekt lesbarer SMART-Identitaet.
#
# Der autorisierte Generator akzeptiert ausschliesslich
# verifizierte Hardware-IDs aus der persistenten Baseline.
# Ohne Freigabe bleibt die vorhandene Udev-Identitaet bestehen.

ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="sd*[!0-9]", IMPORT{program}="/bin/bash /boot/config/custom/array-serial/udev-authorized-id.sh /dev/%k"
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="nvme[0-9]*n[0-9]*", IMPORT{program}="/bin/bash /boot/config/custom/array-serial/udev-authorized-id.sh /dev/%k"
