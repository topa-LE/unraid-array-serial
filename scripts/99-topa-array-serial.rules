# topa-LE Unraid Array Serial
# Zusaetzliche Hardwarekennung; bestehende ID_SERIAL bleibt unveraendert.
# Nur ganze Blockgeraete, keine Partitionen.
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="sd[a-z]*", IMPORT{program}="/bin/bash /boot/config/custom/array-serial/serial-id-udev.sh /dev/%k"
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="hd[a-z]*", IMPORT{program}="/bin/bash /boot/config/custom/array-serial/serial-id-udev.sh /dev/%k"
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="vd[a-z]*", IMPORT{program}="/bin/bash /boot/config/custom/array-serial/serial-id-udev.sh /dev/%k"
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="nvme[0-9]*n[0-9]*", IMPORT{program}="/bin/bash /boot/config/custom/array-serial/serial-id-udev.sh /dev/%k"
