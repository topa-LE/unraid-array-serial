# topa-LE Unraid Array Serial
#
# Separate Udev-Regel fuer das physische Unraid-Boot-Laufwerk.
#
# Die systemd-Udev-Standardregeln erzeugen zuvor ihre native USB-ID.
# Danach normalisiert flash-id.sh ausschliesslich die Identitaet des
# physischen Laufwerks, auf dem /boot liegt.
#
# Die Regel erzeugt auf Basis der normalisierten ID_SERIAL einen
# sauberen stabilen Flash-by-id-Link.
#
# install-flash-id.sh entfernt nach erfolgreicher Verifikation
# konkurrierende usb-by-id-Links, die auf dasselbe physische
# Unraid-Boot-Laufwerk zeigen. Dadurch sieht Unraid/emhttp beim Start
# eindeutig die normalisierte Flash-Identitaet.
#
# Es werden ausschliesslich Udev-Eigenschaften und
# /dev/disk/by-id-Symlinks des physischen Boot-Laufwerks verwaltet.
# Dateisystem, Label, UUID, PARTUUID, Hardware-Seriennummer und
# Unraid-Lizenzdaten werden nicht veraendert.

ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="sd*[!0-9]", IMPORT{program}="/bin/bash /boot/config/custom/array-serial/flash-id.sh /dev/%k"
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="sd*[!0-9]", ENV{IDENTITY_SOURCE}=="FLASH", ENV{ID_SERIAL}=="?*", SYMLINK+="disk/by-id/usb-$env{ID_SERIAL}"
